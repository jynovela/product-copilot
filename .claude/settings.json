{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python3 tools/lint_wiki.py *)",
      "Bash(python3 skills/humanize-check/check.py *)",
      "Bash(python3 skills/morning-brief/due.py *)",
      "Bash(date +%F)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(mkdir *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/guard_raw.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
